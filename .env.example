# Copy to .env and edit. Every variable is optional; the defaults run fully offline.

# ---------- storage & auth ----------
ADPROOF_DATABASE_URL=sqlite:///./adproof.db
ADPROOF_JWT_SECRET=please-replace-with-a-long-random-string-32-bytes-min
ADPROOF_SEED_DEMO=1                  # 0 in production: no demo accounts on the login page

# ---------- model ----------
# mock = deterministic offline model (no key needed; tests and CI use it)
ADPROOF_LLM_PROVIDER=mock
# ADPROOF_MOCK_LATENCY_MS=250        # demo only: simulated model latency, labelled in the trace view

# Doubao (Volcengine Ark), Hunyuan and DeepSeek share one OpenAI-compatible adapter:
# ADPROOF_LLM_PROVIDER=openai_compat
# ADPROOF_LLM_PRESET=doubao           # doubao | hunyuan | deepseek (or set ADPROOF_LLM_BASE_URL)
# ADPROOF_LLM_API_KEY=...
# ADPROOF_LLM_MODEL=<model or endpoint id from the vendor console>
# ADPROOF_LLM_JSON_MODE=1             # response_format=json_object; auto-retries without it on HTTP 400
# ADPROOF_LLM_TEMPERATURE=0.2

# ---------- pipeline ----------
# ADPROOF_RULES_PATH=./rules/adproof_rules.yaml   # point at a mounted volume to keep online edits
# ADPROOF_REVIEW_CHANNELS=rule,llm                 # rule | llm | rule,llm
# ADPROOF_REWRITE_MAX_ROUNDS=2
# ADPROOF_MAX_SCRIPT_CHARS=6000
